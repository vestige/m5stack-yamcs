{
  "uid": "m5sat-mission",
  "title": "M5Sat ミッション要求",
  "tags": [
    "m5sat"
  ],
  "timezone": "browser",
  "editable": true,
  "description": "利用者がランプの色と時間を要求し、運用者の承認を経て、衛星が実行したことをテレメトリで確かめる (#44)",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "volkovlabs-form-panel",
      "title": "ミッション要求を出す",
      "description": "利用者は「何をしたいか」(色と時間) だけを出す。ミッション要求サービスが検査して SET_LAMP のコマンドにし、YAMCS の Queues で運用者が承認してから衛星へ送る",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "options": {
        "layout": {
          "variant": "single",
          "orientation": "horizontal",
          "padding": 10,
          "sections": []
        },
        "initial": {
          "method": "-",
          "code": "",
          "contentType": "application/json",
          "highlight": false,
          "highlightColor": "red"
        },
        "updateEnabled": "auto",
        "update": {
          "method": "POST",
          "url": "http://localhost:8095/requests",
          "contentType": "application/json",
          "payloadMode": "all",
          "confirm": false,
          "header": [],
          "code": "// ミッション要求サービスの応答 (受け付けた / 断った理由) を、そのまま通知に出す\nconst response = context.panel.response;\nif (!response) {\n  context.grafana.notifyError(['ミッション要求', 'ミッション要求サービスにつながりません']);\n  return;\n}\nreturn response.clone().json().then((body) => {\n  if (response.ok && body.accepted) {\n    context.grafana.notifySuccess(['ミッション要求', body.message]);\n  } else {\n    context.grafana.notifyError(['ミッション要求', body.message || `断られました (${response.status})`]);\n  }\n  context.grafana.refresh();\n}).catch(() => {\n  context.grafana.notifyError(['ミッション要求', `応答を読めませんでした (${response.status})`]);\n});"
        },
        "submit": {
          "text": "要求を出す",
          "icon": "rocket",
          "variant": "primary",
          "foregroundColor": "",
          "backgroundColor": ""
        },
        "reset": {
          "variant": "hidden",
          "text": "Reset",
          "icon": "process",
          "foregroundColor": "",
          "backgroundColor": ""
        },
        "saveDefault": {
          "variant": "hidden",
          "text": "Save Default",
          "icon": "save",
          "foregroundColor": "",
          "backgroundColor": ""
        },
        "buttonGroup": {
          "orientation": "left",
          "size": "md"
        },
        "elements": [
          {
            "uid": "requester",
            "id": "requester",
            "title": "要求する人",
            "type": "string",
            "value": "",
            "labelWidth": 14,
            "tooltip": "入れると「要求を出す」が押せる",
            "section": "",
            "hidden": false,
            "unit": "",
            "width": 30
          },
          {
            "uid": "color",
            "id": "color",
            "title": "ランプの色",
