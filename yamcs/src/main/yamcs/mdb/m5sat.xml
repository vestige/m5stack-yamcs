<?xml version="1.0" encoding="UTF-8"?>
<!--
  衛星 M5Sat の Mission Database (XTCE)

  /M5Sat          CCSDS Primary Header (全パケット共通)
  /M5Sat/Bus      バス: HK (Housekeeping) テレメトリ    APID 101  lib/TelemetryPacket/src/HousekeepingPacket.h
                       コマンドへの応答 (ACK)          APID 102  lib/TelemetryPacket/src/AckPacket.h
                       イベント                        APID 103  lib/TelemetryPacket/src/EventPacket.h
                       コマンド (TC)                   APID 110  lib/Satellite/src/Telecommand.h
  /M5Sat/GNSS     ペイロード: GNSS受信機のテレメトリ    APID 100  lib/TelemetryPacket/src/TelemetryPacket.h
-->
<SpaceSystem name="M5Sat" xmlns="http://www.omg.org/spec/XTCE/20180204" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
	<TelemetryMetaData>
		<ParameterTypeSet>
			<IntegerParameterType name="CCSDS_Version_Type" signed="false">
				<IntegerDataEncoding sizeInBits="3" />
			</IntegerParameterType>
			<BooleanParameterType name="CCSDS_Type_Type" zeroStringValue="TM" oneStringValue="TC">
				<IntegerDataEncoding sizeInBits="1" />
			</BooleanParameterType>
			<BooleanParameterType name="CCSDS_Sec_Hdr_Flag_Type" zeroStringValue="NotPresent" oneStringValue="Present">
				<IntegerDataEncoding sizeInBits="1" />
			</BooleanParameterType>
			<IntegerParameterType name="CCSDS_APID_Type" signed="false">
				<IntegerDataEncoding sizeInBits="11" />
			</IntegerParameterType>
			<EnumeratedParameterType name="CCSDS_Group_Flags_Type">
				<IntegerDataEncoding sizeInBits="2" />
				<EnumerationList>
					<Enumeration value="0" label="Continuation" />
					<Enumeration value="1" label="First" />
					<Enumeration value="2" label="Last" />
					<Enumeration value="3" label="Standalone" />
				</EnumerationList>
			</EnumeratedParameterType>
			<IntegerParameterType name="CCSDS_Sequence_Count_Type" signed="false">
				<IntegerDataEncoding sizeInBits="14" />
			</IntegerParameterType>
			<IntegerParameterType name="CCSDS_Packet_Length_Type" signed="false">
				<UnitSet>
					<Unit>octets</Unit>
				</UnitSet>
				<IntegerDataEncoding sizeInBits="16" />
			</IntegerParameterType>
		</ParameterTypeSet>

		<ParameterSet>
			<Parameter name="CCSDS_Version" parameterTypeRef="CCSDS_Version_Type" />
			<Parameter name="CCSDS_Type" parameterTypeRef="CCSDS_Type_Type" />
			<Parameter name="CCSDS_Sec_Hdr_Flag" parameterTypeRef="CCSDS_Sec_Hdr_Flag_Type" />
			<Parameter name="CCSDS_APID" parameterTypeRef="CCSDS_APID_Type" />
			<Parameter name="CCSDS_Group_Flags" parameterTypeRef="CCSDS_Group_Flags_Type" />
			<Parameter name="CCSDS_Sequence_Count" parameterTypeRef="CCSDS_Sequence_Count_Type" />
			<Parameter name="CCSDS_Packet_Length" parameterTypeRef="CCSDS_Packet_Length_Type" />
		</ParameterSet>

		<ContainerSet>
			<SequenceContainer name="CCSDSPacket" abstract="true">
				<EntryList>
					<ParameterRefEntry parameterRef="CCSDS_Version" />
					<ParameterRefEntry parameterRef="CCSDS_Type" />
					<ParameterRefEntry parameterRef="CCSDS_Sec_Hdr_Flag" />
					<ParameterRefEntry parameterRef="CCSDS_APID" />
					<ParameterRefEntry parameterRef="CCSDS_Group_Flags" />
					<ParameterRefEntry parameterRef="CCSDS_Sequence_Count" />
					<ParameterRefEntry parameterRef="CCSDS_Packet_Length" />
				</EntryList>
			</SequenceContainer>
		</ContainerSet>
	</TelemetryMetaData>

	<!-- バス: 衛星の健康状態 -->
	<SpaceSystem name="Bus">
		<TelemetryMetaData>
			<ParameterTypeSet>
				<EnumeratedParameterType name="Operation_Mode_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="SAFE" />
						<Enumeration value="1" label="NOMINAL" />
						<Enumeration value="2" label="MISSION" />
					</EnumerationList>
				</EnumeratedParameterType>
				<BooleanParameterType name="Power_Type" zeroStringValue="OFF" oneStringValue="ON">
					<IntegerDataEncoding sizeInBits="8" />
				</BooleanParameterType>
				<IntegerParameterType name="Command_Count_Type" signed="false">
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerParameterType>
				<EnumeratedParameterType name="Command_Id_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="NONE" />
						<Enumeration value="1" label="NO_OP" />
						<Enumeration value="2" label="SET_MODE" />
						<Enumeration value="3" label="SET_TM_INTERVAL" />
						<Enumeration value="4" label="PAYLOAD_POWER" />
						<Enumeration value="5" label="RESET_COUNTERS" />
						<Enumeration value="6" label="BEEP" />
					</EnumerationList>
				</EnumeratedParameterType>
				<IntegerParameterType name="Tc_Sequence_Type" signed="false">
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerParameterType>
				<EnumeratedParameterType name="Ack_Stage_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="1" label="ACCEPTED" />
						<Enumeration value="2" label="REJECTED" />
						<Enumeration value="3" label="COMPLETED" />
						<Enumeration value="4" label="FAILED" />
					</EnumerationList>
				</EnumeratedParameterType>
				<EnumeratedParameterType name="Event_Severity_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="INFO" />
						<Enumeration value="1" label="WATCH" />
						<Enumeration value="2" label="WARNING" />
						<Enumeration value="3" label="DISTRESS" />
						<Enumeration value="4" label="CRITICAL" />
						<Enumeration value="5" label="SEVERE" />
					</EnumerationList>
				</EnumeratedParameterType>
				<EnumeratedParameterType name="Event_Id_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="1" label="BOOT" />
						<Enumeration value="2" label="MODE_CHANGED" />
						<Enumeration value="3" label="PAYLOAD_POWER_CHANGED" />
						<Enumeration value="4" label="TM_INTERVAL_CHANGED" />
						<Enumeration value="5" label="COUNTERS_RESET" />
						<Enumeration value="6" label="COMMAND_REJECTED" />
					</EnumerationList>
				</EnumeratedParameterType>
				<IntegerParameterType name="Event_Arg_Type" signed="false">
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerParameterType>
				<EnumeratedParameterType name="Error_Code_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="NONE" />
						<Enumeration value="1" label="UNKNOWN_COMMAND" />
						<Enumeration value="2" label="INVALID_LENGTH" />
						<Enumeration value="3" label="INVALID_ARGUMENT" />
						<Enumeration value="4" label="NOT_ALLOWED" />
						<Enumeration value="5" label="MALFORMED_PACKET" />
					</EnumerationList>
				</EnumeratedParameterType>
				<IntegerParameterType name="Rssi_Type" signed="true">
					<UnitSet>
						<Unit>dBm</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="8" encoding="twosComplement" />
				</IntegerParameterType>
				<IntegerParameterType name="Bytes_Type" signed="false">
					<UnitSet>
						<Unit>bytes</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="32" />
				</IntegerParameterType>
				<IntegerParameterType name="Uptime_Type" signed="false">
					<UnitSet>
						<Unit>ms</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="32" />
				</IntegerParameterType>
				<IntegerParameterType name="Boot_Count_Type" signed="false">
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerParameterType>
				<!-- ESP-IDF の esp_reset_reason_t -->
				<EnumeratedParameterType name="Reset_Reason_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="UNKNOWN" />
						<Enumeration value="1" label="POWER_ON" />
						<Enumeration value="2" label="EXTERNAL" />
						<Enumeration value="3" label="SOFTWARE" />
						<Enumeration value="4" label="PANIC" />
						<Enumeration value="5" label="INTERRUPT_WATCHDOG" />
						<Enumeration value="6" label="TASK_WATCHDOG" />
						<Enumeration value="7" label="OTHER_WATCHDOG" />
						<Enumeration value="8" label="DEEP_SLEEP" />
						<Enumeration value="9" label="BROWNOUT" />
						<Enumeration value="10" label="SDIO" />
					</EnumerationList>
				</EnumeratedParameterType>
			</ParameterTypeSet>

			<ParameterSet>
				<Parameter name="Mode" parameterTypeRef="Operation_Mode_Type" shortDescription="運用モード" />
				<Parameter name="PayloadPower" parameterTypeRef="Power_Type" shortDescription="ペイロード(GNSS受信機)の電源" />
				<Parameter name="AcceptedCommands" parameterTypeRef="Command_Count_Type" shortDescription="受理したコマンド数" />
				<Parameter name="RejectedCommands" parameterTypeRef="Command_Count_Type" shortDescription="拒否したコマンド数" />
				<Parameter name="LastCommandId" parameterTypeRef="Command_Id_Type" shortDescription="最後に受理したコマンド" />
				<Parameter name="WifiRssi" parameterTypeRef="Rssi_Type" shortDescription="Wi-Fiの電波の強さ" />
				<Parameter name="FreeHeap" parameterTypeRef="Bytes_Type" shortDescription="ヒープの空き容量" />
				<Parameter name="MinFreeHeap" parameterTypeRef="Bytes_Type" shortDescription="起動してからのヒープの空き容量の最小値" />
				<Parameter name="Uptime" parameterTypeRef="Uptime_Type" shortDescription="起動からの経過時間" />
				<Parameter name="BootCount" parameterTypeRef="Boot_Count_Type" shortDescription="再起動の回数 (電源を切っても保持)" />
				<Parameter name="ResetReason" parameterTypeRef="Reset_Reason_Type" shortDescription="前回の再起動の理由" />
				<Parameter name="AckTcSequence" parameterTypeRef="Tc_Sequence_Type" shortDescription="ACK: どのTC (シーケンス番号) への応答か" />
				<Parameter name="AckCommandId" parameterTypeRef="Command_Id_Type" shortDescription="ACK: コマンド" />
				<Parameter name="AckStage" parameterTypeRef="Ack_Stage_Type" shortDescription="ACK: 受理・拒否・実行完了・実行失敗" />
				<Parameter name="AckErrorCode" parameterTypeRef="Error_Code_Type" shortDescription="ACK: 拒否・失敗の理由" />
				<Parameter name="EventSeverity" parameterTypeRef="Event_Severity_Type" shortDescription="イベント: 重要度" />
				<Parameter name="EventId" parameterTypeRef="Event_Id_Type" shortDescription="イベント: 種類" />
				<Parameter name="EventArg1" parameterTypeRef="Event_Arg_Type" shortDescription="イベント: 引数1 (イベントごとに意味が違う)" />
				<Parameter name="EventArg2" parameterTypeRef="Event_Arg_Type" shortDescription="イベント: 引数2 (イベントごとに意味が違う)" />
			</ParameterSet>

			<ContainerSet>
				<!-- APID 101: HK (offset 6 以降) -->
				<SequenceContainer name="Housekeeping">
					<EntryList>
						<ParameterRefEntry parameterRef="Mode" />
						<ParameterRefEntry parameterRef="PayloadPower" />
						<ParameterRefEntry parameterRef="AcceptedCommands" />
						<ParameterRefEntry parameterRef="RejectedCommands" />
						<ParameterRefEntry parameterRef="LastCommandId" />
						<ParameterRefEntry parameterRef="WifiRssi" />
						<ParameterRefEntry parameterRef="FreeHeap" />
						<ParameterRefEntry parameterRef="MinFreeHeap" />
						<ParameterRefEntry parameterRef="Uptime" />
						<ParameterRefEntry parameterRef="BootCount" />
						<ParameterRefEntry parameterRef="ResetReason" />
					</EntryList>
					<BaseContainer containerRef="/M5Sat/CCSDSPacket">
						<RestrictionCriteria>
							<ComparisonList>
								<Comparison parameterRef="/M5Sat/CCSDS_Type" value="TM" />
								<Comparison parameterRef="/M5Sat/CCSDS_APID" value="101" />
							</ComparisonList>
						</RestrictionCriteria>
					</BaseContainer>
				</SequenceContainer>

				<!-- APID 102: コマンドへの応答 (ACK) -->
				<SequenceContainer name="CommandAck">
					<EntryList>
						<ParameterRefEntry parameterRef="AckTcSequence" />
						<ParameterRefEntry parameterRef="AckCommandId" />
						<ParameterRefEntry parameterRef="AckStage" />
						<ParameterRefEntry parameterRef="AckErrorCode" />
					</EntryList>
					<BaseContainer containerRef="/M5Sat/CCSDSPacket">
						<RestrictionCriteria>
							<ComparisonList>
								<Comparison parameterRef="/M5Sat/CCSDS_Type" value="TM" />
								<Comparison parameterRef="/M5Sat/CCSDS_APID" value="102" />
							</ComparisonList>
						</RestrictionCriteria>
					</BaseContainer>
				</SequenceContainer>

				<!-- APID 103: 衛星で起きた出来事 (イベント) -->
				<SequenceContainer name="SatelliteEvent">
					<EntryList>
						<ParameterRefEntry parameterRef="EventSeverity" />
						<ParameterRefEntry parameterRef="EventId" />
						<ParameterRefEntry parameterRef="EventArg1" />
						<ParameterRefEntry parameterRef="EventArg2" />
					</EntryList>
					<BaseContainer containerRef="/M5Sat/CCSDSPacket">
						<RestrictionCriteria>
							<ComparisonList>
								<Comparison parameterRef="/M5Sat/CCSDS_Type" value="TM" />
								<Comparison parameterRef="/M5Sat/CCSDS_APID" value="103" />
							</ComparisonList>
						</RestrictionCriteria>
					</BaseContainer>
				</SequenceContainer>
			</ContainerSet>

			<AlgorithmSet>
				<!--
				  衛星はイベントの番号と数値だけを送ってくるので、ここで文章にして YAMCS の Events に出す。
				  過去データの再生で同じイベントが重複しないよう、リアルタイムのプロセッサのときだけ出す。
				-->
				<CustomAlgorithm name="SatelliteEventMessage">
					<AlgorithmText language="JavaScript"><![CDATA[
if (Yamcs.processorName() != "realtime") return;

var MODE = ["SAFE", "NOMINAL", "MISSION"];
var COMMAND = ["NONE", "NO_OP", "SET_MODE", "SET_TM_INTERVAL", "PAYLOAD_POWER", "RESET_COUNTERS", "BEEP"];
var ERROR = ["", "知らないコマンドです", "引数の長さが違います", "引数が範囲外です",
             "今の状態では実行できません", "TCパケットとして不正です"];
var RESET_REASON = ["UNKNOWN", "POWER_ON", "EXTERNAL", "SOFTWARE", "PANIC", "INTERRUPT_WATCHDOG",
                    "TASK_WATCHDOG", "OTHER_WATCHDOG", "DEEP_SLEEP", "BROWNOUT", "SDIO"];

function name(list, i) { return list[i] !== undefined ? list[i] : String(i); }

var a1 = arg1.rawValue;
var a2 = arg2.rawValue;
var message;
switch (eventId.value) {
  case "BOOT":
    message = "起動しました (" + a1 + "回目, 理由: " + name(RESET_REASON, a2) + ")";
    break;
  case "MODE_CHANGED":
    message = "運用モードを " + name(MODE, a1) + " から " + name(MODE, a2) + " に変更しました";
    break;
  case "PAYLOAD_POWER_CHANGED":
    message = "ペイロードの電源を " + (a1 == 1 ? "ON" : "OFF") + " にしました";
    break;
  case "TM_INTERVAL_CHANGED":
    message = "テレメトリの送信周期を " + a1 + "ms に変更しました";
    break;
  case "COUNTERS_RESET":
    message = "コマンドカウンタをリセットしました";
    break;
  case "COMMAND_REJECTED":
    message = "コマンド " + name(COMMAND, a1) + " を拒否しました: " + name(ERROR, a2);
    break;
  default:
    message = "不明なイベント (" + eventId.rawValue + ", " + a1 + ", " + a2 + ")";
}

var source = "M5Sat";
var type = String(eventId.value);
switch (severity.value) {
  case "WATCH": EventLog.watch(source, type, message); break;
  case "WARNING": EventLog.warning(source, type, message); break;
  case "DISTRESS": EventLog.distress(source, type, message); break;
  case "CRITICAL": EventLog.critical(source, type, message); break;
  case "SEVERE": EventLog.severe(source, type, message); break;
  default: EventLog.info(source, type, message);
}
]]></AlgorithmText>
					<InputSet>
						<InputParameterInstanceRef parameterRef="EventSeverity" inputName="severity" />
						<InputParameterInstanceRef parameterRef="EventId" inputName="eventId" />
						<InputParameterInstanceRef parameterRef="EventArg1" inputName="arg1" />
						<InputParameterInstanceRef parameterRef="EventArg2" inputName="arg2" />
					</InputSet>
					<TriggerSet>
						<OnParameterUpdateTrigger parameterRef="EventId" />
					</TriggerSet>
				</CustomAlgorithm>
			</AlgorithmSet>
		</TelemetryMetaData>

		<CommandMetaData>
			<ArgumentTypeSet>
				<IntegerArgumentType name="Command_Id_Arg_Type" signed="false">
					<IntegerDataEncoding sizeInBits="8" />
				</IntegerArgumentType>
				<EnumeratedArgumentType name="Mode_Arg_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="SAFE" />
						<Enumeration value="1" label="NOMINAL" />
						<Enumeration value="2" label="MISSION" />
					</EnumerationList>
				</EnumeratedArgumentType>
				<EnumeratedArgumentType name="Power_Arg_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="OFF" />
						<Enumeration value="1" label="ON" />
					</EnumerationList>
				</EnumeratedArgumentType>
				<!-- 範囲のチェックは衛星側だけで行う (地上側のチェックは 5-5 で入れる) -->
				<IntegerArgumentType name="Milliseconds_Arg_Type" signed="false">
					<UnitSet>
						<Unit>ms</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerArgumentType>
			</ArgumentTypeSet>

			<MetaCommandSet>
				<!--
				  全コマンド共通の TC パケット (APID 110)
				  長さフィールドとシーケンス番号は IssCommandPostprocessor が埋める
				-->
				<MetaCommand name="M5SatCommand" abstract="true">
					<ArgumentList>
						<Argument name="CommandId" argumentTypeRef="Command_Id_Arg_Type" />
					</ArgumentList>
					<CommandContainer name="M5SatCommand">
						<EntryList>
							<!-- version=0, type=TC, secondary header=0, APID=110 -->
							<FixedValueEntry name="CCSDS_Packet_Id" binaryValue="106E" sizeInBits="16" />
							<!-- sequence flags=unsegmented, sequence count=0 (後で埋める) -->
							<FixedValueEntry name="CCSDS_Packet_Sequence" binaryValue="C000" sizeInBits="16" />
							<FixedValueEntry name="CCSDS_Packet_Length" binaryValue="0000" sizeInBits="16" />
							<ArgumentRefEntry argumentRef="CommandId" />
						</EntryList>
					</CommandContainer>
					<!-- 衛星から届くACKのシーケンス番号を照らし合わせて、コマンドの段階を進める -->
					<VerifierSet>
					<AcceptedVerifier name="Accepted">
						<BooleanExpression>
							<ANDedConditions>
								<Condition>
									<ParameterInstanceRef parameterRef="/yamcs/cmdHist/ccsds-seqcount" />
									<ComparisonOperator>==</ComparisonOperator>
									<ParameterInstanceRef parameterRef="AckTcSequence" />
								</Condition>
								<Condition>
									<ParameterInstanceRef parameterRef="AckStage" />
									<ComparisonOperator>==</ComparisonOperator>
									<Value>ACCEPTED</Value>
								</Condition>
							</ANDedConditions>
						</BooleanExpression>
						<CheckWindow timeToStopChecking="PT5S" timeWindowIsRelativeTo="commandRelease" />
					</AcceptedVerifier>
					<CompleteVerifier name="Complete">
						<BooleanExpression>
							<ANDedConditions>
								<Condition>
									<ParameterInstanceRef parameterRef="/yamcs/cmdHist/ccsds-seqcount" />
									<ComparisonOperator>==</ComparisonOperator>
									<ParameterInstanceRef parameterRef="AckTcSequence" />
								</Condition>
								<Condition>
									<ParameterInstanceRef parameterRef="AckStage" />
									<ComparisonOperator>==</ComparisonOperator>
									<Value>COMPLETED</Value>
								</Condition>
							</ANDedConditions>
						</BooleanExpression>
						<CheckWindow timeToStopChecking="PT10S" timeWindowIsRelativeTo="commandRelease" />
					</CompleteVerifier>
					<FailedVerifier>
						<BooleanExpression>
							<ANDedConditions>
								<Condition>
									<ParameterInstanceRef parameterRef="/yamcs/cmdHist/ccsds-seqcount" />
									<ComparisonOperator>==</ComparisonOperator>
									<ParameterInstanceRef parameterRef="AckTcSequence" />
								</Condition>
								<ORedConditions>
									<Condition>
										<ParameterInstanceRef parameterRef="AckStage" />
										<ComparisonOperator>==</ComparisonOperator>
										<Value>REJECTED</Value>
									</Condition>
									<Condition>
										<ParameterInstanceRef parameterRef="AckStage" />
										<ComparisonOperator>==</ComparisonOperator>
										<Value>FAILED</Value>
									</Condition>
								</ORedConditions>
							</ANDedConditions>
						</BooleanExpression>
						<CheckWindow timeToStopChecking="PT10S" timeWindowIsRelativeTo="commandRelease" />
					</FailedVerifier>
					</VerifierSet>
				</MetaCommand>

				<MetaCommand name="NO_OP" shortDescription="何もしない。通信路の確認用">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="1" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<CommandContainer name="NO_OP">
						<EntryList />
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
				<MetaCommand name="SET_MODE" shortDescription="運用モードを切り替える。SAFEにするとペイロードもOFFになる">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="2" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<ArgumentList>
						<Argument name="Mode" argumentTypeRef="Mode_Arg_Type" />
					</ArgumentList>
					<CommandContainer name="SET_MODE">
						<EntryList>
							<ArgumentRefEntry argumentRef="Mode" />
						</EntryList>
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
				<MetaCommand name="SET_TM_INTERVAL" shortDescription="テレメトリの送信周期を変える (200〜10000ms)">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="3" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<ArgumentList>
						<Argument name="Interval" argumentTypeRef="Milliseconds_Arg_Type" />
					</ArgumentList>
					<CommandContainer name="SET_TM_INTERVAL">
						<EntryList>
							<ArgumentRefEntry argumentRef="Interval" />
						</EntryList>
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
				<MetaCommand name="PAYLOAD_POWER" shortDescription="ペイロード(GNSS受信機)の電源をON/OFFする">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="4" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<ArgumentList>
						<Argument name="State" argumentTypeRef="Power_Arg_Type" />
					</ArgumentList>
					<CommandContainer name="PAYLOAD_POWER">
						<EntryList>
							<ArgumentRefEntry argumentRef="State" />
						</EntryList>
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
				<MetaCommand name="RESET_COUNTERS" shortDescription="コマンドカウンタをリセットする">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="5" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<CommandContainer name="RESET_COUNTERS">
						<EntryList />
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
				<MetaCommand name="BEEP" shortDescription="スピーカーを鳴らす (50〜2000ms)">
					<BaseMetaCommand metaCommandRef="M5SatCommand">
						<ArgumentAssignmentList>
							<ArgumentAssignment argumentName="CommandId" argumentValue="6" />
						</ArgumentAssignmentList>
					</BaseMetaCommand>
					<ArgumentList>
						<Argument name="Duration" argumentTypeRef="Milliseconds_Arg_Type" />
					</ArgumentList>
					<CommandContainer name="BEEP">
						<EntryList>
							<ArgumentRefEntry argumentRef="Duration" />
						</EntryList>
						<BaseContainer containerRef="M5SatCommand" />
					</CommandContainer>
				</MetaCommand>
			</MetaCommandSet>
		</CommandMetaData>
	</SpaceSystem>

	<!-- ペイロード: GNSS受信機 -->
	<SpaceSystem name="GNSS">
		<TelemetryMetaData>
			<ParameterTypeSet>
				<AbsoluteTimeParameterType name="Unix_Time_Type">
					<Encoding units="seconds">
						<IntegerDataEncoding sizeInBits="32" />
					</Encoding>
					<ReferenceTime>
						<Epoch>UNIX</Epoch>
					</ReferenceTime>
				</AbsoluteTimeParameterType>
				<IntegerParameterType name="Millisecond_Type" signed="false">
					<UnitSet>
						<Unit>ms</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="16" />
				</IntegerParameterType>
				<FloatParameterType name="Degrees_Type" sizeInBits="64">
					<UnitSet>
						<Unit>deg</Unit>
					</UnitSet>
					<FloatDataEncoding sizeInBits="64" />
				</FloatParameterType>
				<FloatParameterType name="Altitude_Type" sizeInBits="32">
					<UnitSet>
						<Unit>m</Unit>
					</UnitSet>
					<FloatDataEncoding sizeInBits="32" />
				</FloatParameterType>
				<IntegerParameterType name="Satellites_Type" signed="false">
					<IntegerDataEncoding sizeInBits="8" />
					<!-- 衛星が4機未満では3D測位できないので警告する -->
					<DefaultAlarm>
						<StaticAlarmRanges>
							<WarningRange minInclusive="4" />
						</StaticAlarmRanges>
					</DefaultAlarm>
				</IntegerParameterType>
				<EnumeratedParameterType name="Fix_Quality_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="0" label="NoFix" />
						<Enumeration value="1" label="GPS" />
						<Enumeration value="2" label="DGPS" />
						<Enumeration value="3" label="PPS" />
						<Enumeration value="4" label="RTK" />
						<Enumeration value="5" label="FloatRTK" />
						<Enumeration value="6" label="Estimated" />
						<Enumeration value="7" label="Manual" />
						<Enumeration value="8" label="Simulation" />
					</EnumerationList>
				</EnumeratedParameterType>
				<EnumeratedParameterType name="Fix_Type_Type">
					<IntegerDataEncoding sizeInBits="8" />
					<EnumerationList>
						<Enumeration value="1" label="NoFix" />
						<Enumeration value="2" label="2D" />
						<Enumeration value="3" label="3D" />
					</EnumerationList>
					<!-- 測位できていなければ警告する -->
					<DefaultAlarm>
						<EnumerationAlarmList>
							<EnumerationAlarm alarmLevel="warning" enumerationLabel="NoFix" />
						</EnumerationAlarmList>
					</DefaultAlarm>
				</EnumeratedParameterType>
				<IntegerParameterType name="Reserved_Type" signed="false">
					<IntegerDataEncoding sizeInBits="3" />
				</IntegerParameterType>
				<BooleanParameterType name="Flag_Type">
					<IntegerDataEncoding sizeInBits="1" />
				</BooleanParameterType>
				<IntegerParameterType name="Uptime_Type" signed="false">
					<UnitSet>
						<Unit>ms</Unit>
					</UnitSet>
					<IntegerDataEncoding sizeInBits="32" />
				</IntegerParameterType>
				<IntegerParameterType name="Counter_Type" signed="false">
					<IntegerDataEncoding sizeInBits="32" />
				</IntegerParameterType>
			</ParameterTypeSet>

			<ParameterSet>
				<Parameter name="UtcTime" parameterTypeRef="Unix_Time_Type" shortDescription="GNSSから得たUTC時刻 (無効なら1970-01-01)" />
				<Parameter name="UtcMillisecond" parameterTypeRef="Millisecond_Type" shortDescription="UTC時刻のミリ秒" />
				<Parameter name="Latitude" parameterTypeRef="Degrees_Type" shortDescription="緯度 (北緯が正)" />
				<Parameter name="Longitude" parameterTypeRef="Degrees_Type" shortDescription="経度 (東経が正)" />
				<Parameter name="Altitude" parameterTypeRef="Altitude_Type" shortDescription="海抜高度" />
				<Parameter name="Satellites" parameterTypeRef="Satellites_Type" shortDescription="測位に使用している衛星数" />
				<Parameter name="FixQuality" parameterTypeRef="Fix_Quality_Type" shortDescription="測位品質 (GGA)" />
				<Parameter name="FixType" parameterTypeRef="Fix_Type_Type" shortDescription="測位の次元 (GSA)" />
				<Parameter name="FlagsReserved" parameterTypeRef="Reserved_Type" />
				<Parameter name="RmcActive" parameterTypeRef="Flag_Type" shortDescription="RMCのステータスがA (Active)" />
				<Parameter name="AltitudeValid" parameterTypeRef="Flag_Type" shortDescription="高度が有効" />
				<Parameter name="PositionValid" parameterTypeRef="Flag_Type" shortDescription="緯度経度が有効" />
				<Parameter name="DateValid" parameterTypeRef="Flag_Type" shortDescription="日付が有効" />
				<Parameter name="TimeValid" parameterTypeRef="Flag_Type" shortDescription="時刻が有効" />
				<Parameter name="Uptime" parameterTypeRef="Uptime_Type" shortDescription="M5Stackの起動からの経過時間" />
				<Parameter name="NmeaValidSentences" parameterTypeRef="Counter_Type" shortDescription="正常に受信したNMEAセンテンス数" />
				<Parameter name="NmeaChecksumErrors" parameterTypeRef="Counter_Type" shortDescription="NMEAのチェックサムエラー数" />
			</ParameterSet>

			<ContainerSet>
				<!-- APID 100: GNSSテレメトリ (offset 6 以降) -->
				<SequenceContainer name="GnssTelemetry">
					<EntryList>
						<ParameterRefEntry parameterRef="UtcTime" />
						<ParameterRefEntry parameterRef="UtcMillisecond" />
						<ParameterRefEntry parameterRef="Latitude" />
						<ParameterRefEntry parameterRef="Longitude" />
						<ParameterRefEntry parameterRef="Altitude" />
						<ParameterRefEntry parameterRef="Satellites" />
						<ParameterRefEntry parameterRef="FixQuality" />
						<ParameterRefEntry parameterRef="FixType" />
						<!-- Flags (1byte): 上位ビットから reserved(3), RMC, ALT, POS, DATE, TIME -->
						<ParameterRefEntry parameterRef="FlagsReserved" />
						<ParameterRefEntry parameterRef="RmcActive" />
						<ParameterRefEntry parameterRef="AltitudeValid" />
						<ParameterRefEntry parameterRef="PositionValid" />
						<ParameterRefEntry parameterRef="DateValid" />
						<ParameterRefEntry parameterRef="TimeValid" />
						<ParameterRefEntry parameterRef="Uptime" />
						<ParameterRefEntry parameterRef="NmeaValidSentences" />
						<ParameterRefEntry parameterRef="NmeaChecksumErrors" />
					</EntryList>
					<BaseContainer containerRef="/M5Sat/CCSDSPacket">
						<RestrictionCriteria>
							<ComparisonList>
								<Comparison parameterRef="/M5Sat/CCSDS_Type" value="TM" />
								<Comparison parameterRef="/M5Sat/CCSDS_APID" value="100" />
							</ComparisonList>
						</RestrictionCriteria>
					</BaseContainer>
				</SequenceContainer>
			</ContainerSet>
		</TelemetryMetaData>
	</SpaceSystem>
</SpaceSystem>
