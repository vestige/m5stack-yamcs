  <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
    <widget_type>Text Update</widget_type>
    <name>/M5Sat/Bus/Mode</name>
    <wuid>w7</wuid>
    <x>150</x>
    <y>108</y>
    <width>200</width>
    <height>34</height>
    <visible>true</visible>
    <enabled>true</enabled>
    <actions hook="false" hook_all="false" />
    <rules><rule name="mode color" prop_id="background_color" out_exp="false"><exp bool_exp="pvStr0==&quot;SAFE&quot;"><value><color red="250" green="200" blue="80" /></value></exp><exp bool_exp="pvStr0==&quot;NOMINAL&quot;"><value><color red="200" green="235" blue="205" /></value></exp><exp bool_exp="pvStr0==&quot;MISSION&quot;"><value><color red="190" green="215" blue="250" /></value></exp><pv trig="true">/M5Sat/Bus/Mode</pv></rule></rules>
    <scripts />
    <scale_options><width_scalable>true</width_scalable><height_scalable>true</height_scalable><keep_wh_ratio>false</keep_wh_ratio></scale_options>
    <tooltip></tooltip>
    <pv_name>/M5Sat/Bus/Mode</pv_name>
