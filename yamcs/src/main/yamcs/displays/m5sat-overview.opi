<?xml version="1.0" encoding="UTF-8"?>
<!--
  M5Sat の運用画面 (5-8)。YAMCS の Telemetry → Displays で開く。
  CS-Studio (Yamcs Studio) の OPI 形式。値の欄をクリックするとそのパラメータの詳細へ移る
-->
<display typeId="org.csstudio.opibuilder.Display" version="1.0.0">
  <name>M5Sat 運用画面</name>
  <wuid>root</wuid>
  <x>0</x>
  <y>0</y>
  <width>1070</width>
  <height>612</height>
  <background_color><color red="236" green="239" blue="242" /></background_color>
  <foreground_color><color red="0" green="0" blue="0" /></foreground_color>
  <actions hook="false" hook_all="false" />
  <rules />
  <scripts />
  <macros><include_parent_macros>true</include_parent_macros></macros>
  <show_grid>false</show_grid>
  <show_edit_range>true</show_edit_range>
  <auto_zoom_to_fit_all>false</auto_zoom_to_fit_all>
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <widget_type>Label</widget_type>
    <name>M5Sat 運用画面</name>
    <wuid>w1</wuid>
    <x>20</x>
    <y>12</y>
    <width>400</width>
    <height>30</height>
    <visible>true</visible>
    <enabled>true</enabled>
    <actions hook="false" hook_all="false" />
    <rules />
    <scripts />
    <scale_options><width_scalable>true</width_scalable><height_scalable>true</height_scalable><keep_wh_ratio>false</keep_wh_ratio></scale_options>
    <tooltip></tooltip>
    <text>M5Sat 運用画面</text>
    <font><opifont.name fontName="Liberation Sans" height="18" style="1" pixels="false">Default</opifont.name></font>
    <foreground_color><color red="40" green="60" blue="90" /></foreground_color>
    <background_color><color red="255" green="255" blue="255" /></background_color>
    <border_color><color red="0" green="0" blue="0" /></border_color>
    <border_style>0</border_style>
    <border_width>1</border_width>
    <transparent>true</transparent>
    <horizontal_alignment>0</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <auto_size>false</auto_size>
